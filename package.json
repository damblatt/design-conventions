{
  "name": "@damblatt/visual-kit",
  "version": "1.0.0",
  "description": "Extensible design tokens and conventions for consistent branding across projects",
  "main": "color-palette.json",
  "scripts": {
    "build": "node scripts/build-tokens.js",
    "check": "node scripts/build-tokens.js --check"
  },
  "exports": {
    ".": "./color-palette.json",
    "./colors": "./color-palette.json",
    "./css": "./color-palette.css",
    "./tailwind": "./tailwind-colors.config.ts",
    "./tokens/colors": "./tokens/colors.json",
    "./tokens/borders": "./tokens/borders.json",
    "./css/colors": "./css/colors.css",
    "./css/borders": "./css/borders.css",
    "./css/all": "./css/index.css",
    "./integrations/tailwind": "./integrations/tailwind.ts"
  },
  "keywords": [
    "design-conventions",
    "design-tokens",
    "color-palette",
    "border-tokens",
    "css-variables",
    "tailwind",
    "angular",
    "branding",
    "design-system"
  ],
